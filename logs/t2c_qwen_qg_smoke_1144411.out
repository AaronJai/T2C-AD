[Q-001] Who is suspected of the homicide?
  gold pattern : (p:Person)-[:SUSPECTED_OF]->(:Incident)
  gold cypher  : MATCH (p:Person)-[:SUSPECTED_OF]->(:Incident {crime_type:'homicide'}) RETURN p.name
  C2/C3 cypher : "MATCH (p:Person)-[:SUSPECTED_OF]->(:Incident {crime_type:'homicide'}) RETURN p.name"
  C1 cypher    : "MATCH (Person) -[:SUSPECTED_OF]->(Incident {crime_type:'homicide'}) RETURN Person.name"

[Q-002] Which officers are investigating the homicide?
  gold pattern : (p:Person)-[:INVESTIGATES]->(:Incident)
  gold cypher  : MATCH (p:Person)-[:INVESTIGATES]->(:Incident {crime_type:'homicide'}) RETURN p.name
  C2/C3 cypher : "MATCH (p:Person)-[:INVESTIGATES]->(:Incident {crime_type:'homicide'}) RETURN p.name"
  C1 cypher    : "MATCH (p:Person)-[:INVESTIGATES]->(i:Incident {crime_type:'homicide'}) RETURN p.name"

[Q-003] Who is the victim of the homicide?
  gold pattern : (p:Person)-[:VICTIM_OF]->(:Incident)
  gold cypher  : MATCH (p:Person)-[:VICTIM_OF]->(:Incident {crime_type:'homicide'}) RETURN p.name
  C2/C3 cypher : "MATCH (p:Person)-[:VICTIM_OF]->(:Incident {crime_type:'homicide'}) RETURN p.name"
  C1 cypher    : "MATCH (p:Person)-[:VICTIM_OF]->(i:Incident {crime_type:'homicide'}) RETURN p.name"

